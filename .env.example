# MimmiFlowers Server — Environment Variables
# Copy this file to .env.dev, .env.stg, or .env.prod and fill in real values.
# The ENV variable (set in docker-compose) controls which file is loaded.

# ── Database ──────────────────────────────────────────────────────────
DB_URL=postgresql://mimmi:mimmi_dev@db:5432/mimmiflowers

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SUCCESS_URL=http://localhost:3000/Success/
CANCEL_URL=http://localhost:3000/Cancel/

# ── SMTP (Zoho) ──────────────────────────────────────────────────────
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=info@mimmiflowers.se
ZOHO_SMTP_PASSWORD=your_smtp_password
ZOHO_SMTP_SENDER_NAME=Mimmi Flowers

# ── Optional ──────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
